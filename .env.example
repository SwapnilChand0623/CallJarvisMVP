# Account sign-in. Public values only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service-role key or provider credentials to NEXT_PUBLIC_*.

# --- Server only. Copy this file to .env.local; never commit real values. See docs/live-setup.md. ---
# Supabase project URL and its secret (service role) key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared with agent/.env.local. Generate with: openssl rand -hex 32
VOICE_TOOL_TOKEN=
# The account inbound calls act for. Printed by: npm run live:user -- --phone +1…
VOICE_DEMO_USER_ID=
# Scheduler bearer for /api/internal/outreach. Generate with: openssl rand -hex 32
OUTREACH_TOKEN=
# Outbound FaceTime. The key comes from the Chert dashboard's Developer page.
CHERT_FACETIME_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
# Lets Chert's webhook reach /api/webhooks/chert/facetime?key=<this value>. Generate with: openssl rand -hex 24
CHERT_WEBHOOK_KEY=
# Optional: lets the home simulator's camera recognize props. The same key as agent/.env.local.
GEMINI_API_KEY=
# The same LiveKit project and agent name as agent/.env.local.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=calljarvis

# The public Chert number people call, including country code. Blank shows a coming-soon state.
NEXT_PUBLIC_CHERT_PHONE_NUMBER=
