# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Used by Gemini Live and npm run gemini:check.
# Get a Gemini API key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=calljarvis

# The CallJarvis server that runs voice actions (POST /api/internal/voice). Use the deployed origin, or
# http://localhost:3000 for local development. Leave unset to run calls without tools.
VOICE_API_URL=http://localhost:3000
# Must match VOICE_TOOL_TOKEN on the server. Generate one with: openssl rand -hex 32
VOICE_TOOL_TOKEN=YOUR_VOICE_TOOL_TOKEN
