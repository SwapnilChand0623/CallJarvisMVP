    "help": "node agent.mjs --help"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@livekit/agents": "^1.9.5",
    "@livekit/agents-plugin-google": "^1.9.5",
    "@livekit/rtc-node": "^1.1.0"
  }
}
