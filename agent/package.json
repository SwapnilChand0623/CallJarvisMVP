{
  "name": "chert-student-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "gemini:check": "node --env-file-if-exists=.env.local gemini-check.mjs",
